---
import Row from '../../components/Row.astro'
import Base from '../../layouts/Base.astro'
import { formatDate, getPosts } from '../../site'

const posts = await getPosts()
---

<Base
  title="Thoughts"
  description="Articles by Tim de Vries on AI, product, design and building ventures."
>
  <Row label="Thoughts">
    {posts.length === 0 ? (
      <p class="muted">The first articles are on their way. Meanwhile, read the <a href="/manifesto" class="underline" style="margin-top: 0">manifesto</a>.</p>
    ) : (
      <ul class="table">
        {posts.map((post) => (
          <li>
            <a href={`/thoughts/${post.id}`} draggable="false">{post.data.title}</a>
            <span class="detail">{post.data.description}</span>
            <time class="end" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </li>
        ))}
      </ul>
    )}
  </Row>
</Base>
