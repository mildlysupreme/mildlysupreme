---
import Base from '../../layouts/Base.astro'
import { getCategories } from '../../site'

const categories = await getCategories()
---

<Base title="Nice things" description="A collection of nice things, picked by Tim de Vries.">
  <h1>Nice things</h1>
  <p>A collection of things I like.</p>
  <ul class="categories">
    {categories.map((category) => (
      <li>
        <a href={`/nice-things/${category.id}`} draggable="false">{category.data.title}</a>{' '}
        <span class="count">({category.data.items.length})</span>
      </li>
    ))}
  </ul>
</Base>
