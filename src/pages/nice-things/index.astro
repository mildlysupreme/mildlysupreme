---
import Row from '../../components/Row.astro'
import Base from '../../layouts/Base.astro'
import { getCategories } from '../../site'

const categories = await getCategories()
---

<Base title="Nice things" description="A collection of nice things, picked by Tim de Vries.">
  <Row label="Nice things">
    <ul class="table">
      {categories.map((category) => (
        <li>
          <a href={`/nice-things/${category.id}`} draggable="false">{category.data.title}</a>
          <span class="detail"></span>
          <span class="end">({category.data.items.length})</span>
        </li>
      ))}
    </ul>
  </Row>
</Base>
