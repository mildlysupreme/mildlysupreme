---
import { Image } from 'astro:assets'
import Row from '../components/Row.astro'
import Base from '../layouts/Base.astro'
import { clients, email, moreWork, selectedWork, ventures } from '../data/work'
import { formatDate, getCategories, getPosts } from '../site'

const posts = await getPosts()

// Interests in three columns, each linking to its Nice things category.
const categories = await getCategories()
const byId = (id: string) => categories.find((category) => category.id === id)
const interestColumns = [
  { title: 'Spaces', ids: ['architecture', 'interior', 'libraries'] },
  { title: 'Objects', ids: ['industrial-design', 'watches'] },
  { title: 'Culture and nature', ids: ['japan', 'anime', 'trees', 'people'] },
].map((column) => ({
  ...column,
  items: column.ids.map(byId).filter((category) => category !== undefined),
}))
---

<Base>
  <Row class="hero" label="Tim de Vries">
    <h1>Serial entrepreneur, investor and fast failer.</h1>
    <p>Futurist and contrarian from Heerenveen, building companies with AI and people.</p>
  </Row>

  <div class="row strip-row">
    <div></div>
    <div class="strip" aria-label="Clients">
      <ul>
        {[...clients, ...clients].map((name, i) => (
          <li aria-hidden={i >= clients.length ? 'true' : undefined}>{name}</li>
        ))}
      </ul>
    </div>
  </div>

  <div class="cases" id="work">
    {selectedWork.map((work, i) => (
      <article class="case">
        <div class="caption">
          <p>{work.name}</p>
          <p class="headline">{work.headline}</p>
          <p class="line">{work.line}</p>
          <ul class="tags">
            {work.services.map((service) => <li>{service}</li>)}
          </ul>
        </div>
        <Image
          src={work.image}
          alt={`${work.name}, work by Teqqed`}
          widths={[800, 1200, 1600, 1920]}
          sizes="(min-width: 1200px) 960px, (min-width: 810px) 70vw, 100vw"
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      </article>
    ))}
  </div>

  <Row label="Building">
    <ul class="table">
      {ventures.map((venture) => (
        <li>
          <a href={venture.url}>{venture.name}</a>
          <span class="detail">{venture.line}</span>
          <a class="end" href={venture.url}>{venture.domain}</a>
        </li>
      ))}
    </ul>
  </Row>

  <Row label="More work">
    <ul class="table">
      {moreWork.map((work) => (
        <li><span>{work.name}</span><span class="detail">{work.services}</span><span class="end">Teqqed</span></li>
      ))}
    </ul>
  </Row>

  <Row label="About" id="about">
    <div class="lead">
      <p>
        I'm Tim, a serial entrepreneur, investor and fast failer. I start things, test them
        quickly and keep what works.
      </p>
      <p>
        Over the past decade I've grown a digital agency to over $1M in annual revenue, led
        multiple SaaS launches from zero to exit, and backed founders and ideas I believe in.
      </p>
      <p>
        I'm a futurist by habit and a contrarian by nature. Right now that means AI: I want to
        understand where it takes us, build with it early, and say so when the crowd gets it
        wrong.
      </p>
      <p>
        Teqqed, my studio, is where much of that turns into real products, brands and systems.
        The rest lives here: writing, building, and a growing collection of nice things.
      </p>
    </div>
  </Row>

  <Row label="Interests" contentClass="columns">
    {interestColumns.map((column) => (
      <div>
        <h3>{column.title}</h3>
        <ul>
          {column.items.map((category) => (
            <li>
              <a href={`/nice-things/${category.id}`}>{category.data.title}</a>
              {category.data.items.length > 0 && <span class="count">{category.data.items.length}</span>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </Row>

  <Row label="Writing">
    <ul class="table">
      <li>
        <a href="/manifesto">Manifesto</a>
        <span class="detail">For a more human future</span>
        <span class="end">2026</span>
      </li>
      {posts.map((post) => (
        <li>
          <a href={`/thoughts/${post.id}`}>{post.data.title}</a>
          <span class="detail">{post.data.description}</span>
          <span class="end">{formatDate(post.data.date)}</span>
        </li>
      ))}
      {posts.length === 0 && (
        <li>
          <a href="/thoughts">Thoughts</a>
          <span class="detail">The first articles are on their way</span>
          <span class="end">Soon</span>
        </li>
      )}
    </ul>
  </Row>

  <Row label="Worked with">
    <p class="text">{clients.join(', ')}</p>
  </Row>

  <Row label="Open to conversations with">
    <ol class="numbered">
      <li><sup>1</sup>Founders building products and brands with AI at the core.</li>
      <li><sup>2</sup>People with a contrarian idea who want to test it fast.</li>
      <li><sup>3</sup>Designers, engineers and makers who care about craft.</li>
    </ol>
    <a class="underline" href={`mailto:${email}`}>If that sounds like you, drop me a line</a>
  </Row>

  <Row label="Connect" id="contact">
    <ul class="stack">
      <li><a href={`mailto:${email}`}>Email</a></li>
      <li><a href="https://www.teqqed.com">Teqqed</a></li>
    </ul>
  </Row>

  <Row label="Location">
    <div class="clock">
      <svg viewBox="0 0 100 100" aria-hidden="true">
        {Array.from({ length: 12 }, (_, i) => (
          <line class="tick" x1="50" y1="4" x2="50" y2={i % 3 === 0 ? 12 : 9} transform={`rotate(${i * 30} 50 50)`} />
        ))}
        <line class="hand" data-hand="h" x1="50" y1="50" x2="50" y2="28" stroke-width="2.5" />
        <line class="hand" data-hand="m" x1="50" y1="50" x2="50" y2="14" stroke-width="1.5" />
        <line class="hand second" data-hand="s" x1="50" y1="57" x2="50" y2="10" />
      </svg>
      <span class="place">Heerenveen, NL</span>
    </div>
  </Row>
</Base>

<script is:inline>
  // Local time in Heerenveen for the clock.
  ;(() => {
    const fmt = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Europe/Amsterdam',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    })
    const hands = Object.fromEntries(
      [...document.querySelectorAll('[data-hand]')].map((el) => [el.dataset.hand, el])
    )
    const tick = () => {
      const [h, m, s] = fmt.format(new Date()).split(':').map(Number)
      hands.h.style.transform = `rotate(${(h % 12) * 30 + m / 2}deg)`
      hands.m.style.transform = `rotate(${m * 6}deg)`
      hands.s.style.transform = `rotate(${s * 6}deg)`
    }
    tick()
    setInterval(tick, 1000)
  })()
</script>
