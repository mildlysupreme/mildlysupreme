---
// One section of the page grid, as on nickclement.com: a small grey label on the
// left (400px) and content on the right, each with its own hairline on top.
interface Props {
  label?: string
  id?: string
  class?: string
  contentClass?: string
}

const { label, id, class: className, contentClass } = Astro.props
---

<section class:list={['row', className]} id={id}>
  <div class="label"><slot name="label">{label}</slot></div>
  <div class:list={['content', contentClass]}><slot /></div>
</section>
